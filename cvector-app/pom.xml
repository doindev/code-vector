<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.doindev</groupId>
        <artifactId>cwc-code-vector</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>cvector-app</artifactId>
    <name>cvector-app</name>
    <description>Spring Boot main + executable fat-jar assembly. Entry point for the cvector CLI.</description>

    <dependencies>
        <dependency>
            <groupId>io.doindev</groupId>
            <artifactId>cvector-cli</artifactId>
        </dependency>
        <dependency>
            <groupId>io.doindev</groupId>
            <artifactId>cvector-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>io.doindev</groupId>
            <artifactId>cvector-mcp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>neo4j</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>cvector</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>io.doindev.cvector.CvectorApplication</mainClass>
                </configuration>
                <executions>
                    <!--
                        AOT pre-processes the Spring bean factory at build time so reflection-heavy
                        bean construction can be replaced with generated, branch-predictable code.
                        Picked up at runtime via `-Dspring.aot.enabled=true` (or by GraalVM native).
                        Pairs with CDS (`-XX:SharedArchiveFile=...`) for the best startup wall-clock.
                    -->
                    <execution>
                        <id>process-aot</id>
                        <goals>
                            <goal>process-aot</goal>
                        </goals>
                    </execution>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            mvn -Pdashboard-ui package pulls in the Angular dashboard and bundles its
            built assets into the cvector fat jar so the dashboard command can serve
            them. The dashboard module declares its own front-end build under the same
            profile id, so activating one activates the other in lockstep.
        -->
        <profile>
            <id>dashboard-ui</id>
            <dependencies>
                <dependency>
                    <groupId>io.doindev</groupId>
                    <artifactId>cvector-dashboard</artifactId>
                </dependency>
            </dependencies>
        </profile>

        <!--
            `mvn -Pdist package` produces a self-contained Windows distributable at
            target/dist/cvector/, containing cvector.exe + bundled JRE + the fat jar.
            Skipped from the default build because jpackage adds ~30 s and writes ~150 MB
            to target/.
        -->
        <profile>
            <id>dist</id>
            <build>
                <plugins>
                    <!--
                        jpackage refuses to overwrite an existing destination directory, so a
                        second `mvn -Pdist install` against a populated target/ fails with
                        "Application destination directory ... already exists". Wipe target/dist
                        before jpackage runs so the build is idempotent without forcing a full
                        `mvn clean` (which would invalidate the rest of the reactor's compiled
                        output and add ~30 s to every rebuild).

                        Uses antrun rather than maven-clean-plugin because Windows Defender
                        real-time scanning holds a transient handle on a freshly-jpackaged
                        cvector.exe for several seconds. maven-clean-plugin retries 10× with a
                        100 ms gap (~1 s total) which isn't always enough; antrun's `<delete>`
                        with `failonerror="false"` + a 2 s sleep + a final authoritative delete
                        gives Defender time to release the handle on iterative rebuilds.
                    -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>clean-dist-before-jpackage</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <!--
                                            Poll-delete loop. Windows Defender real-time scan can
                                            hold a freshly-built cvector.exe for 5–15 seconds; one
                                            attempt isn't enough. Five attempts spaced 3 s apart
                                            (~12 s max wait) covers the typical hold window. Only
                                            the final delete fails the build — earlier failures are
                                            swallowed so we keep retrying.
                                        -->
                                        <delete dir="${project.build.directory}/dist" failonerror="false"/>
                                        <sleep seconds="3"/>
                                        <delete dir="${project.build.directory}/dist" failonerror="false"/>
                                        <sleep seconds="3"/>
                                        <delete dir="${project.build.directory}/dist" failonerror="false"/>
                                        <sleep seconds="3"/>
                                        <delete dir="${project.build.directory}/dist" failonerror="false"/>
                                        <sleep seconds="3"/>
                                        <delete dir="${project.build.directory}/dist"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <version>1.6.5</version>
                        <configuration>
                            <name>cvector</name>
                            <appVersion>0.0.1</appVersion>
                            <vendor>doindev</vendor>
                            <input>${project.build.directory}</input>
                            <mainJar>${project.build.finalName}.jar</mainJar>
                            <destination>${project.build.directory}/dist</destination>
                            <type>APP_IMAGE</type>
                            <javaOptions>
                                <option>-Dspring.aot.enabled=true</option>
                            </javaOptions>
                            <!--
                                jpackage can't auto-detect required modules from a non-modular fat jar,
                                so list them explicitly. Covers Spring Boot + jackson + Neo4j driver +
                                Kuzu JNI runtime needs. Add more if a runtime hits ClassNotFoundException
                                for a JDK module.
                            -->
                            <addModules>
                                <module>java.base</module>
                                <module>java.management</module>
                                <module>java.naming</module>
                                <module>java.sql</module>
                                <module>java.net.http</module>
                                <module>java.desktop</module>
                                <module>java.logging</module>
                                <module>java.xml</module>
                                <module>java.security.jgss</module>
                                <module>jdk.crypto.ec</module>
                                <module>jdk.unsupported</module>
                            </addModules>
                        </configuration>
                        <executions>
                            <execution>
                                <id>jpackage</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>jpackage</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
