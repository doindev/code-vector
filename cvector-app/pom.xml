<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.doindev</groupId>
        <artifactId>cwc-code-vector</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>cvector-app</artifactId>
    <name>cvector-app</name>
    <description>Spring Boot main + executable fat-jar assembly. Entry point for the cvector CLI.</description>

    <dependencies>
        <dependency>
            <groupId>io.doindev</groupId>
            <artifactId>cvector-cli</artifactId>
        </dependency>
        <dependency>
            <groupId>io.doindev</groupId>
            <artifactId>cvector-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>io.doindev</groupId>
            <artifactId>cvector-mcp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>neo4j</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>cvector</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>io.doindev.cvector.CvectorApplication</mainClass>
                </configuration>
                <executions>
                    <!--
                        AOT pre-processes the Spring bean factory at build time so reflection-heavy
                        bean construction can be replaced with generated, branch-predictable code.
                        Picked up at runtime via `-Dspring.aot.enabled=true` (or by GraalVM native).
                        Pairs with CDS (`-XX:SharedArchiveFile=...`) for the best startup wall-clock.
                    -->
                    <execution>
                        <id>process-aot</id>
                        <goals>
                            <goal>process-aot</goal>
                        </goals>
                    </execution>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            mvn -Pdashboard-ui package pulls in the Angular dashboard and bundles its
            built assets into the cvector fat jar so the dashboard command can serve
            them. The dashboard module declares its own front-end build under the same
            profile id, so activating one activates the other in lockstep.
        -->
        <profile>
            <id>dashboard-ui</id>
            <dependencies>
                <dependency>
                    <groupId>io.doindev</groupId>
                    <artifactId>cvector-dashboard</artifactId>
                </dependency>
            </dependencies>
        </profile>

        <!--
            `mvn -Pdist package` produces a self-contained Windows distributable at
            target/dist/cvector/, containing cvector.exe + bundled JRE + the fat jar.
            Skipped from the default build because jpackage adds ~30 s and writes ~150 MB
            to target/.
        -->
        <profile>
            <id>dist</id>
            <build>
                <plugins>
                    <!--
                        jpackage refuses to overwrite an existing destination directory, so a
                        second `mvn -Pdist install` against a populated target/ fails with
                        "Application destination directory ... already exists". Wipe target/dist
                        before jpackage runs so the build is idempotent without forcing a full
                        `mvn clean` (which would invalidate the rest of the reactor's compiled
                        output and add ~30 s to every rebuild).

                        Windows note: if you're on Windows with Defender real-time scanning
                        enabled, this delete can fail when Defender holds an open handle to a
                        freshly-built cvector.exe from a prior build. Easiest permanent fix is
                        to add {@code cvector-app/target/} to Defender's folder exclusions
                        (Settings → Windows Security → Virus & threat protection → Manage
                        settings → Exclusions → Add an exclusion → Folder). Without that, the
                        one-shot workaround is {@code rm -rf cvector-app/target/dist} before
                        the rebuild, or {@code mvn clean -Pdist install} for a full clean.
                    -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-clean-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>clean-dist-before-jpackage</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>clean</goal>
                                </goals>
                                <configuration>
                                    <excludeDefaultDirectories>true</excludeDefaultDirectories>
                                    <filesets>
                                        <fileset>
                                            <directory>${project.build.directory}/dist</directory>
                                        </fileset>
                                    </filesets>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <version>1.6.5</version>
                        <configuration>
                            <name>cvector</name>
                            <appVersion>0.0.1</appVersion>
                            <vendor>doindev</vendor>
                            <input>${project.build.directory}</input>
                            <mainJar>${project.build.finalName}.jar</mainJar>
                            <destination>${project.build.directory}/dist</destination>
                            <type>APP_IMAGE</type>
                            <!--
                                Intentionally NOT setting -Dspring.aot.enabled=true here.
                                The AOT artifacts are generated at build time against the
                                default WebApplicationType (NONE), which works fine for the
                                CLI subcommands but breaks `cvector dashboard`: the
                                pre-baked bean definitions do not include a ServletWebServerFactory,
                                so Tomcat never starts and Spring fails with "Web application
                                could not be started". CLI mode is ~1 s slower without AOT,
                                but the .exe has to support every subcommand correctly.
                                Users who only want CLI speed can re-enable AOT manually:
                                  cvector.exe -J-Dspring.aot.enabled=true status
                            -->
                            <!--
                                jpackage can't auto-detect required modules from a non-modular fat jar,
                                so list them explicitly. Covers Spring Boot + jackson + Neo4j driver +
                                Kuzu JNI runtime needs. Add more if a runtime hits ClassNotFoundException
                                for a JDK module.
                            -->
                            <addModules>
                                <module>java.base</module>
                                <module>java.management</module>
                                <module>java.naming</module>
                                <module>java.sql</module>
                                <module>java.net.http</module>
                                <module>java.desktop</module>
                                <module>java.logging</module>
                                <module>java.xml</module>
                                <module>java.security.jgss</module>
                                <module>java.instrument</module>
                                <module>java.scripting</module>
                                <module>java.rmi</module>
                                <module>java.compiler</module>
                                <module>jdk.zipfs</module>
                                <module>jdk.crypto.ec</module>
                                <module>jdk.unsupported</module>
                            </addModules>
                        </configuration>
                        <executions>
                            <execution>
                                <id>jpackage</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>jpackage</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
