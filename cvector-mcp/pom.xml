<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.doindev</groupId>
        <artifactId>cwc-code-vector</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>cvector-mcp</artifactId>
    <name>cvector-mcp</name>
    <description>Spring AI MCP server exposing cvector graph queries as tools.</description>

    <dependencies>
        <dependency>
            <groupId>io.doindev</groupId>
            <artifactId>cvector-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.doindev</groupId>
            <artifactId>cvector-neo4j</artifactId>
        </dependency>
        <dependency>
            <groupId>io.doindev</groupId>
            <artifactId>cvector-embedded-kuzudb-server</artifactId>
        </dependency>
        <dependency>
            <groupId>io.doindev</groupId>
            <artifactId>cvector-rules</artifactId>
        </dependency>
        <!--
            cvector-cli brings in InProcessScanService + every Parser bean so the MCP
            cv_scan_project tool can run scans in the same JVM that holds the embedded
            Kuzu file lock. The CLI module is already a transitive dep of cvector-app
            (which is the only assembly that boots cvector-mcp), so this declaration
            costs nothing in shipped-jar size — it just makes the InProcessScanService
            type visible at compile time inside cvector-mcp.
        -->
        <dependency>
            <groupId>io.doindev</groupId>
            <artifactId>cvector-cli</artifactId>
        </dependency>
        <!--
            Base stdio MCP transport for `cvector serve` (JSON-RPC over System.in / System.out).
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server</artifactId>
            <version>2.0.0-M6</version>
        </dependency>
        <!--
            HTTP (SSE + Streamable) MCP transport for the dashboard co-host scenario:
            `cvector dashboard` activates the `mcp` profile alongside Tomcat and Spring AI
            auto-wires the MCP endpoint into the same servlet container. Without this dep,
            the `mcp` profile would have no HTTP handler and clients POSTing to /mcp would
            hit the 404 fallback. Coexists with the base stdio starter — Spring AI picks the
            transport at runtime based on `spring.ai.mcp.server.stdio` (true = stdio only,
            false = HTTP/SSE wired into Spring WebMVC).
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
