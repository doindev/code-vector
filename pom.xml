<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.doindev</groupId>
    <artifactId>cwc-code-vector</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>cvector parent</name>
    <description>cvector — Neo4j-backed code knowledge graph (parent POM).</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.compiler.release>17</maven.compiler.release>

        <spring-boot.version>3.5.14</spring-boot.version>
        <neo4j-java-driver.version>5.20.0</neo4j-java-driver.version>
        <javaparser.version>3.25.10</javaparser.version>
        <picocli.version>4.7.6</picocli.version>
        <jackson.version>2.15.4</jackson.version>
        <testcontainers.version>1.19.7</testcontainers.version>
        <assertj.version>3.25.3</assertj.version>
        <jsqlparser.version>4.9</jsqlparser.version>
        <snakeyaml.version>2.2</snakeyaml.version>
        <maven-model.version>3.9.6</maven-model.version>
        <spring-ai.version>1.0.0</spring-ai.version>
        <directory-watcher.version>0.18.0</directory-watcher.version>
        <antlr4.version>4.13.2</antlr4.version>
    </properties>

    <modules>
        <module>cvector-core</module>
        <module>cvector-neo4j</module>
        <module>cvector-parser-java</module>
        <module>cvector-parser-sql</module>
        <module>cvector-parser-config</module>
        <module>cvector-parser-ts</module>
        <module>cvector-parser-style</module>
        <module>cvector-parser-python</module>
        <module>cvector-parser-terraform</module>
        <module>cvector-parser-docker</module>
        <module>cvector-parser-csharp</module>
        <module>cvector-parser-rust</module>
        <module>cvector-parser-go</module>
        <module>cvector-parser-javascript</module>
        <module>cvector-parser-kotlin</module>
        <module>cvector-parser-c</module>
        <module>cvector-parser-cpp</module>
        <module>cvector-parser-solidity</module>
        <module>cvector-parser-php</module>
        <module>cvector-parser-graphql</module>
        <module>cvector-parser-protobuf</module>
        <module>cvector-parser-bicep</module>
        <module>cvector-parser-cypher</module>
        <module>cvector-parser-sparql</module>
        <module>cvector-parser-plsql</module>
